{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "America/Chicago",
  "schedule": ["* 6-11 * * 1"],
  "automerge": false,
  "extends": [":dependencyDashboard"],
  "branchPrefix": "renovate/",
  "gitIgnoredAuthors": ["16675082+roryeckel@users.noreply.github.com"],
  "rangeStrategy": "bump",
  "enabledManagers": ["npm", "nodenv", "github-actions", "pip_requirements"],
  "ignorePaths": ["**/node_modules/**", "**/dist/**", ".capture/**", "fixtures/**", "docs/**", "examples/*/com.*/**"],
  "pip_requirements": {
    "managerFilePatterns": ["/^\\.github/requirements/[^/]+\\.txt$/"]
  },
  "packageRules": [
    {
      "description": "Keep the older dashboard-schema compatibility validator as a fixed baseline",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/ci.yml"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "matchCurrentValue": "44.206.2",
      "enabled": false
    },
    {
      "description": "Node declarations stay on the oldest supported runtime major",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": ">=22 <23"
    },
    {
      "description": "The compatibility compiler API stays within typescript-eslint's supported minor line",
      "matchManagers": ["npm"],
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": ">=6 <6.1"
    },
    {
      "description": "The compatibility runtime follows the manually declared Node minimum",
      "matchManagers": ["nodenv"],
      "matchFileNames": [".github/node/compatibility/.node-version"],
      "enabled": false
    },
    {
      "description": "Wait for the same 24-hour npm cooldown enforced by pnpm installs",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "internalChecksFilter": "strict"
    },
    {
      "description": "One reviewed PR for non-major workspace dependencies",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "npm dependencies (non-major)"
    },
    {
      "description": "CI runtimes, actions, and sidecar tooling share a weekly PR",
      "matchManagers": ["nodenv", "github-actions", "pip_requirements"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "CI and tooling (non-major)"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["packageManager"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "groupName": "CI and tooling (non-major)"
    },
    {
      "description": "Major migrations require dashboard approval and individual PRs",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": null
    },
    {
      "description": "The supported Node floor is a manual compatibility decision",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchPackageNames": ["node"],
      "enabled": false
    },
    {
      "description": "The SDK's cross-major Zod peer range is a manual compatibility contract",
      "matchManagers": ["npm"],
      "matchDepTypes": ["pnpm.catalog.zod-sdk-peer"],
      "matchPackageNames": ["zod"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["pnpm.catalog.zod4"],
      "matchPackageNames": ["zod"],
      "allowedVersions": ">=4 <5"
    },
    {
      "description": "The standalone npm runtime shares the example's Zod major line",
      "matchManagers": ["npm"],
      "matchFileNames": ["examples/agent-plugin/runtime/package.json"],
      "matchPackageNames": ["zod"],
      "allowedVersions": ">=4 <5"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["pnpm.catalog.semver-runtime", "pnpm.catalog.semver-tooling"],
      "matchPackageNames": ["semver"],
      "allowedVersions": ">=7 <8"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 6-11 1 * *"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "dependencyDashboardApproval": false,
    "automerge": false,
    "groupName": null
  }
}
