{
  "name": "hooknostic",
  "version": "0.1.0",
  "description": "Hooknostic CLI: check, build, doctor, inspect",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "publishConfig": { "access": "public" },
  "files": ["bin", "dist"],
  "bin": {
    "hooknostic": "./bin/hooknostic.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@hooknostic/sdk": "workspace:*",
    "esbuild": "^0.24.2"
  },
  "devDependencies": {
    "@hooknostic/adapter-claude": "workspace:*",
    "@hooknostic/adapter-codex": "workspace:*",
    "@hooknostic/adapter-opencode": "workspace:*",
    "@hooknostic/core": "workspace:*",
    "@hooknostic/runtime": "workspace:*",
    "@hooknostic/testkit": "workspace:*",
    "@types/semver": "^7.5.8",
    "semver": "^7.6.3"
  }
}
