{
  "name": "hooknostic",
  "version": "0.1.0",
  "description": "Hooknostic CLI: check, build, doctor, inspect",
  "type": "module",
  "bin": {
    "hooknostic": "./bin/hooknostic.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "bundle": "esbuild src/bin.ts --bundle --format=esm --platform=node --target=node20 --external:esbuild --outfile=dist/hooknostic.mjs --log-level=warning"
  },
  "dependencies": {
    "@hooknostic/adapter-claude": "workspace:*",
    "@hooknostic/adapter-codex": "workspace:*",
    "@hooknostic/adapter-opencode": "workspace:*",
    "@hooknostic/core": "workspace:*",
    "@hooknostic/sdk": "workspace:*",
    "semver": "^7.6.3"
  },
  "devDependencies": {
    "@hooknostic/testkit": "workspace:*",
    "@types/semver": "^7.5.8",
    "esbuild": "^0.24.2"
  }
}
