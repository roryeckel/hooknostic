node_modules/
dist/
hooknostic-build.json

# ...except the rewrite-shell example, which commits its build output on
# purpose. It is the subject of the CI reproducibility gate, and it makes this
# repository practise the model docs/decisions/0006 recommends to consumers --
# without it, the committed-artifact pattern was documented here and practised
# nowhere. Re-including a path under an ignored directory needs the directory
# itself un-ignored first, hence both lines.
!examples/rewrite-shell/dist/
!examples/rewrite-shell/dist/hooknostic-build.json
# agent-plugin too, because it is the only example exercising `agentPlugin` --
# the config shape whose build report used to embed an absolute machine path,
# which the rewrite-shell gate structurally could not see.
!examples/agent-plugin/dist/
!examples/agent-plugin/dist/hooknostic-build.json
.hooknostic-staging-*/
examples/*/com.anthropic.claude-code/
!examples/agent-plugin/com.anthropic.claude-code/
.capture/*/captured/
# nested git repos used for codex/opencode capture + smoke (documented in fixtures READMEs)
.capture/codex/
.capture/codex-smoke/
.capture/opencode/
.capture/opencode-smoke/
*.tsbuildinfo
.eslintcache
coverage/
*.log
.DS_Store

# Generated from hooks.json.template; embeds an absolute machine path.
.capture/codex-output/.codex/hooks.json
.capture/opencode-stop-smoke/
# The opencode smoke test asks the agent to attempt a forbidden file; when the
# agent resolves the path against the repo root instead of the scratch project,
# the debris lands here.
forbidden-marker.txt
# Scratch copies the CLI build tests work in (see cleanExample).
examples/.buildtest-*/
