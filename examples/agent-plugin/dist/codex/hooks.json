{
  "description": "Agent Plugins package with a skill, MCP server, and hooknostic-compiled lifecycle hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|view_image",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooknostic/hooknostic.mjs\"",
            "timeout": 6
          }
        ]
      }
    ]
  }
}
