{
  "description": "Agent Plugins package with a skill, MCP server, and hooknostic-compiled lifecycle hooks",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/runtime/hooknostic.mjs"
            ],
            "timeout": 6
          }
        ]
      }
    ]
  }
}
