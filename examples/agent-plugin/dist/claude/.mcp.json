{
  "mcpServers": {
    "greeter": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/src/greet-mcp.mjs"
      ],
      "env": {
        "PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}"
      },
      "cwd": "${CLAUDE_PLUGIN_ROOT}"
    }
  }
}
