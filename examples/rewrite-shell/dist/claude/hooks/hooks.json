{
  "description": "Protect and normalize shell commands",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/runtime/hooknostic.mjs"
            ],
            "timeout": 6
          }
        ]
      }
    ]
  }
}
