{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.hooknostic/artifacts/claude/runtime/hooknostic.mjs"
            ],
            "timeout": 6,
            "timeoutSec": "hooknostic: Claude Code only; GitHub Copilot CLI must not run this entry"
          }
        ]
      }
    ]
  }
}
